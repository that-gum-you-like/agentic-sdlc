{
  "name": "agentic-sdlc",
  "projectDir": "/home/bryce/agentic-sdlc",
  "appDir": ".",
  "testCmd": "node --test 'tests/*.test.mjs' 'agents/__tests__/*.test.mjs'",
  "agents": [
    "sdlc-developer",
    "jony-aive",
    "sdlc-reviewer",
    "sdlc-documentarian"
  ],
  "notification": {
    "provider": "telegram",
    "channel": "",
    "desktop": true,
    "mailboxPath": "pm/mailbox.md",
    "mediaDir": "pm/media",
    "triggers": {
      "blocker": true,
      "budgetAlert": true,
      "highSeverityFailure": true,
      "dailySummary": false,
      "deployComplete": true,
      "deployFailed": true,
      "deployRolledBack": true,
      "drainComplete": false,
      "mergeComplete": false
    }
  },
  "humanWellness": {
    "enabled": true,
    "dailyMaxHours": 10,
    "nightCutoff": "23:00",
    "breakIntervalHours": 3
  },
  "capabilityMonitoring": {
    "enabled": true,
    "driftThreshold": 3,
    "windowSize": 10
  },
  "orchestration": {
    "adapter": "file-based"
  },
  "llm": {
    "defaultProvider": "openrouter"
  },
  "doneChecklist": [
    "openspec",
    "tests",
    "commit",
    "push"
  ]
}
